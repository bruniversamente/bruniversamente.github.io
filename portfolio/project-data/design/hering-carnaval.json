            ]
          },
          {
            "type": "media",
            "items": [
              {
                "id": "m026",
                "caption": "Pesquisa e conceituação: fitas coloridas"
              }
            ]
          },
          {
            "type": "media",
            "items": [
              {
                "id": "m027",
