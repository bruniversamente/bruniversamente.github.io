    "chapters": [
      {
        "id": "projeto",
        "label": "O projeto",
        "title": "O projeto",
        "blocks": [
          {
            "type": "board",
            "tree": {
              "tag": "div",
              "attrs": {
                "class": "carnaval-project-logos",
                "style": "display:flex;align-items:center;gap:3.2rem;flex-wrap:wrap;margin-bottom:2.4rem"
